<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0"
         DefaultTargets="RestoreCleanRebuild"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- All solutions we want to build in CI (skip any that are not present) -->
  <ItemGroup>
    <!-- Core -->
    <Solution Include="SAM\SAM.sln" Condition="Exists('SAM\SAM.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Systems\SAM_Systems.sln" Condition="Exists('SAM_Systems\SAM_Systems.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Psychrometrics\SAM_Psychrometrics.sln" Condition="Exists('SAM_Psychrometrics\SAM_Psychrometrics.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Mollier\SAM_Mollier.sln" Condition="Exists('SAM_Mollier\SAM_Mollier.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Windows\SAM_Windows.sln" Condition="Exists('SAM_Windows\SAM_Windows.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>

    <!-- Optional modules (only if submodule exists) -->
    <Solution Include="SAM_IFC\SAM_IFC.sln" Condition="Exists('SAM_IFC\SAM_IFC.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Topologic\SAM_Topologic.sln" Condition="Exists('SAM_Topologic\SAM_Topologic.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>

    <!-- Some repos historically vary by folder/file name -->
    <Solution Include="SAM_BHom\SAM_BHoM.sln" Condition="Exists('SAM_BHom\SAM_BHoM.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_BHom\SAM_BHom.sln" Condition="Exists('SAM_BHom\SAM_BHom.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>

    <Solution Include="SAM_gbXML\SAM_gbXML.sln" Condition="Exists('SAM_gbXML\SAM_gbXML.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_GEM\SAM_GEM.sln" Condition="Exists('SAM_GEM\SAM_GEM.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_LadybugTools\SAM_LadybugTools.sln" Condition="Exists('SAM_LadybugTools\SAM_LadybugTools.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Solver\SAM_Solver.sln" Condition="Exists('SAM_Solver\SAM_Solver.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_SolarCalculator\SAM_SolarCalculator.sln" Condition="Exists('SAM_SolarCalculator\SAM_SolarCalculator.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Tas\SAM_Tas.sln" Condition="Exists('SAM_Tas\SAM_Tas.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Excel\SAM_Excel.sln" Condition="Exists('SAM_Excel\SAM_Excel.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_SQLite\SAM_SQLite.sln" Condition="Exists('SAM_SQLite\SAM_SQLite.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>

    <!-- OpenStudio is often x64 -->
    <Solution Include="SAM_OpenStudio\SAM_OpenStudio.sln" Condition="Exists('SAM_OpenStudio\SAM_OpenStudio.sln')">
      <Properties>Configuration=Release;Platform=x64</Properties>
    </Solution>

    <!-- These caused your failures when not present -->
    <Solution Include="SAM_Acoustic\SAM_Acoustic.sln" Condition="Exists('SAM_Acoustic\SAM_Acoustic.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Origin\SAM_Origin.sln" Condition="Exists('SAM_Origin\SAM_Origin.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>

    <!-- Revit 2025+ -->
    <Solution Include="SAM_Revit\SAM_Revit.sln" Condition="Exists('SAM_Revit\SAM_Revit.sln')">
      <Properties>Configuration=Release2025;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Revit_UI\SAM_Revit_UI.sln" Condition="Exists('SAM_Revit_UI\SAM_Revit_UI.sln')">
      <Properties>Configuration=Release2025;Platform=Any CPU</Properties>
    </Solution>

    <Solution Include="SAM_Revit\SAM_Revit.sln" Condition="Exists('SAM_Revit\SAM_Revit.sln')">
      <Properties>Configuration=Release2026;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Revit_UI\SAM_Revit_UI.sln" Condition="Exists('SAM_Revit_UI\SAM_Revit_UI.sln')">
      <Properties>Configuration=Release2026;Platform=Any CPU</Properties>
    </Solution>

    <!-- Desktop UI / Rhino UI / Multitasker -->
    <Solution Include="SAM_UI\SAM_UI.sln" Condition="Exists('SAM_UI\SAM_UI.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Rhino_UI\SAM_Rhino_UI.sln" Condition="Exists('SAM_Rhino_UI\SAM_Rhino_UI.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
    <Solution Include="SAM_Multitasker\SAM_Multitasker.sln" Condition="Exists('SAM_Multitasker\SAM_Multitasker.sln')">
      <Properties>Configuration=Release;Platform=Any CPU</Properties>
    </Solution>
  </ItemGroup>

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform      Condition=" '$(Platform)' == '' ">Any CPU</Platform>

    <!-- If anything in the chain treats warnings as errors, do NOT fail on NU1701 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1701</WarningsNotAsErrors>

    <!-- Prebuilt SAM_Windows bits used as ReferencePath -->
    <WindowsRefPath>$(MSBuildThisFileDirectory)SAM_Windows\build</WindowsRefPath>

    <!-- Properties applied to every child MSBuild call from this project -->
    <CommonCIProps>
      UseSharedCompilation=false;
      RunPostBuildEvent=OnOutputUpdated;
      ReferencePath=$(WindowsRefPath);$(ReferencePath);
      TreatWarningsAsErrors=$(TreatWarningsAsErrors);
      WarningsNotAsErrors=$(WarningsNotAsErrors)
    </CommonCIProps>
  </PropertyGroup>

  <Target Name="Clean">
    <MSBuild Projects="@(Solution)"
             BuildInParallel="false"
             Targets="Clean"
             Properties="%(Solution.Properties);$(CommonCIProps)" />
  </Target>

  <Target Name="Build">
    <MSBuild Projects="@(Solution)"
             BuildInParallel="false"
             Targets="Build"
             Properties="%(Solution.Properties);$(CommonCIProps)" />
  </Target>

  <Target Name="Rebuild">
    <MSBuild Projects="@(Solution)"
             BuildInParallel="false"
             Targets="Rebuild"
             Properties="%(Solution.Properties);$(CommonCIProps)" />
  </Target>

  <Target Name="Restore">
    <MSBuild Projects="@(Solution)"
             BuildInParallel="false"
             Targets="Restore"
             Properties="%(Solution.Properties);$(CommonCIProps)" />
  </Target>

  <Target Name="RestoreCleanRebuild"
          DependsOnTargets="Restore;Clean;Rebuild" />
</Project>
